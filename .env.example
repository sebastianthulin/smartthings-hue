# Use the auth and service origins, for example:
# https://auth.domain.tld
# https://service.domain.tld
# Use http://localhost:8787 for local development with npm run auth:broker.
VITE_SMARTTHINGS_AUTH_URL=https://auth.domain.tld
VITE_SMARTTHINGS_SERVICE_URL=https://service.domain.tld
# Legacy fallback if you still use one shared origin:
VITE_SMARTTHINGS_BROKER_URL=
VITE_SMARTTHINGS_SCOPES=r:locations:* r:devices:* x:devices:* r:scenes:* x:scenes:*

SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
SMARTTHINGS_ALLOWED_ORIGINS=https://sebastianthulin.github.io,http://localhost:5174
SMARTTHINGS_BROKER_PORT=8787
SMARTTHINGS_TOKEN_URL=https://api.smartthings.com/oauth/token
SMARTTHINGS_AUTH_RELAY_TTL_MS=300000

# Production relay storage on Vercel: set one of these Upstash REST pairs.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=